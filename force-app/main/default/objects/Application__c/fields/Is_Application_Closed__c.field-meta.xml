<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Application_Closed__c</fullName>
    <formula>OR (
ISPICKVAL(Stage__c,&apos;Completed&apos;),
ISPICKVAL(Stage__c,&apos;Cancelled&apos;),
ISPICKVAL(Stage__c,&apos;Rejected&apos;),
ISPICKVAL(Stage__c,&apos;Closed&apos;)
)</formula>
    <label>Is Application Closed?</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
