<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Additional Documents</masterLabel>
    <description>Upload and manage additional loan documents (UI sample based on P4 Additional Documents).</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Opportunity</object>
                <object>Application__c</object>
            </objects>
            <property name="recordId" type="String" default="{!recordId}"
                      label="Record ID"
                      description="The record ID of the Application" />
            <property name="applicantId" type="String"
                      label="Applicant ID"
                      description="Optional applicant ID for submit" />
            <property name="screenType" type="String"
                      label="Screen Type"
                      description="Empty for Post Sanction; PreDisbursement for pre-disbursement" />
            <property name="isStagePast" type="Boolean" label="Is Stage Past" default="false"
                      description="When true, stage is read-only and Next is disabled" />
            <property name="isReadOnly" type="Boolean" default="false"
                      label="Read Only" />
            <property name="isCompletedView" type="Boolean" default="false"
                      label="Completed View" />
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="recordId" type="String" label="Record ID"
                      description="The record ID of the Application" />
            <property name="applicantId" type="String" label="Applicant ID" />
            <property name="screenType" type="String" label="Screen Type" />
            <property name="isStagePast" type="Boolean" label="Is Stage Past" default="false"
                      description="When true, stage is read-only and Next is disabled" />
            <property name="isReadOnly" type="Boolean" default="false" label="Read Only" />
            <property name="isCompletedView" type="Boolean" default="false" label="Completed View" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>