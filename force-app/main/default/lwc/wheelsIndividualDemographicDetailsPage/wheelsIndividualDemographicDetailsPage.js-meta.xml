<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Wheels Individual Demographic Details</masterLabel>
    <description>Component for capturing individual demographic details including customer information, references, and signature</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Application__c</object>
                <object>Applicant__c</object>
            </objects>
            <property name="recordId" type="String" default="{!recordId}"
                      label="Record ID"
                      description="The record ID of the Application or Applicant" />
            <property name="currentViewId" type="String" label="Current View Id"
                      description="Stage menu item id for losnextstage navigation"/>
            <property name="tab" type="String" label="Stage Tab"
                      description="Stage tab label (e.g. Demographic Details)"/>
            <property name="stagePhrase" type="String" label="Stage Phrase"
                      description="Stage phrase for losnextstage navigation"/>
            <property name="isStagePast" type="Boolean" label="Is Stage Past" default="false"
                      description="When true, stage is read-only"/>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightningCommunity__Default">
            <property name="recordId" type="String"
                      label="Record ID"
                      description="The record ID of the Application or Applicant" />
            <property name="currentViewId" type="String" label="Current View Id"
                      description="Stage menu item id for losnextstage navigation"/>
            <property name="tab" type="String" label="Stage Tab"
                      description="Stage tab label (e.g. Demographic Details)"/>
            <property name="stagePhrase" type="String" label="Stage Phrase"
                      description="Stage phrase for losnextstage navigation"/>
            <property name="isStagePast" type="Boolean" label="Is Stage Past" default="false"
                      description="When true, stage is read-only"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>