<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Payment Disbursement Screen</masterLabel>
    <description>Payment release queue and beneficiary disbursement workspace for Post Disbursement.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__UrlAddressable</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage,lightningCommunity__Default">
            <property name="recordId" type="String" default="{!recordId}" label="Record Id"
                description="Application__c record Id." />
            <property name="isStagePast" type="Boolean" label="Is Stage Past"
                description="When true, the screen is read-only." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>