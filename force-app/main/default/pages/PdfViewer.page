<apex:page showHeader="false" sidebar="false" standardStylesheets="false"
           applyBodyTag="false" applyHtmlTag="false" cache="true">
<html>
<head>
<style>
html, body { margin: 0; padding: 0; height: 100vh; width: 100%; overflow: hidden; }
embed { width: 100%; height: 100%; border: none; }
.msg { display: flex; align-items: center; justify-content: center; height: 100%; font-family: 'Salesforce Sans', Arial, sans-serif; color: #444; font-size: 14px; }
</style>
</head>
<body>
<div id="root"><div class="msg">Loading PDF&#8230;</div></div>
<script>
(function() {
    var cvId = '{!JSENCODE($CurrentPage.parameters.cvId)}';
    var sessionId = '{!JSENCODE($Api.Session_Id)}';
    if (!cvId) {
        document.getElementById('root').innerHTML = '<div class="msg">No file specified.</div>';
        return;
    }
    var xhr = new XMLHttpRequest();
    xhr.open('GET', '/services/data/v59.0/sobjects/ContentVersion/' + encodeURIComponent(cvId) + '/VersionData', true);
    xhr.setRequestHeader('Authorization', 'Bearer ' + sessionId);
    xhr.responseType = 'blob';
    xhr.onload = function() {
        if (xhr.status >= 200 && xhr.status < 300) {
            var blob = new Blob([xhr.response], { type: 'application/pdf' });
            var url = URL.createObjectURL(blob);
            var el = document.createElement('embed');
            el.setAttribute('src', url);
            el.setAttribute('type', 'application/pdf');
            el.setAttribute('width', '100%');
            el.setAttribute('height', '100%');
            document.getElementById('root').innerHTML = '';
            document.getElementById('root').appendChild(el);
        } else {
            document.getElementById('root').innerHTML = '<div class="msg">Failed to load PDF (HTTP ' + xhr.status + ')</div>';
        }
    };
    xhr.onerror = function() {
        document.getElementById('root').innerHTML = '<div class="msg">Network error loading PDF.</div>';
    };
    xhr.send();
})();
</script>
</body>
</html>
</apex:page>